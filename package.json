    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "shiki": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
